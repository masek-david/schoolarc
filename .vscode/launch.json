    "version": "0.2.0",
    "configurations": [
        {
            "name": "Schoolarc",
            "request": "launch",
            "type": "dart",
            "args": [
                "--flavor",
                "dev"
            ]
        },
        {
            "name": "Schoolarc (profile)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--flavor",
                "dev"
            ]
        },
        {
            "name": "Schoolarc (release)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--flavor",
                "dev"
            ]
        },
        {
            "name": "Schoolarc (debug prod)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--flavor",
                "prod"
            ]
        },
        {
            "name": "Schoolarc web 8080",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                // "--no-web-experimental-hot-reload",
                // "--web-hostname=192.168.100.107",
                "--web-port=8080"
            ]
        },
        {
            "name": "Schoolarc web 8080 release",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                // "--no-web-experimental-hot-reload",
                // "--web-hostname=192.168.100.107",
                "--web-port=8080"
            ]
        }
    ]
